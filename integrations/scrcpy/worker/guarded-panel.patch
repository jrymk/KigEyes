+    public ControlMessageReader(InputStream rawInputStream) { this(rawInputStream, false); }
+    /** Direct worker relay records after buffering, so local commands never split a packet. */
+    public ControlMessageReader(InputStream rawInputStream, boolean recordPackets) {
+        InputStream input = new BufferedInputStream(rawInputStream);
+        if (recordPackets) {
+            captured = new java.io.ByteArrayOutputStream();
+            input = new java.io.FilterInputStream(input) {
+                @Override public int read() throws IOException {
+                    int value = in.read(); if (value >= 0) captured.write(value); return value;
+                }
+                @Override public int read(byte[] bytes, int offset, int length) throws IOException {
+                    int n = in.read(bytes, offset, length); if (n > 0) captured.write(bytes, offset, n); return n;
+                }
+            };
+        }
+        dis = new DataInputStream(input);
+    }
+    public byte[] readPacket() throws IOException {
+        if (captured == null) throw new IllegalStateException("Packet recording disabled");
+        captured.reset(); read(); return captured.toByteArray();
