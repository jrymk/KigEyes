(version 1)

(rule dp_to_zone
   (constraint clearance (min 0.35mm))
   (condition "A.Type == 'Zone' && B.Type == 'Track' && B.inDiffPair('*') "))

(rule batt
   (constraint clearance (min 0.4mm))
   (condition "A.Type == 'Zone' && A.NetName == 'GND' && (B.NetName == '/BATT' || B.NetName == '/BATT_POSTSHUNT') "))

(rule sw_node
   (constraint clearance (min 0.2mm))
   (condition "A.Type == 'Zone' && B.NetName == '*SW' && A.NetName != B.NetName "))
